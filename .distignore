# Files/folders to exclude when packaging the plugin for distribution.
# Anything listed here is NOT part of the .zip uploaded to wordpress.org.

.git
.gitignore
.distignore
README.md
assets/banner.svg
*.zip

# Test checks, fixtures and paid-plugin stand-ins live outside the plugin
# folder; listed here too so a zip of the repo root never picks them up.
tests
tests/standins
.github
RELEASING.md
